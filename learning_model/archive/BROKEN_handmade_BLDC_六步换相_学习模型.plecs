    Component {
      Type          CScript
      Name          "换相逻辑"
      Show          on
      Position      [400, 400]
      Direction     up
      Flipped       off
      LabelPosition south
      Frame         [-30, -30; 30, 30]
      NumInputs     "3"
      NumOutputs    "6"
      NumContStates "0"
      NumDiscStates "0"
      NumZCSignals  "0"
      DirectFeedthrough "1"
      Ts            "0"
      Parameters    ""
      LangStandard  "2"
      SourceCode    "// PLECS C-Script: BLDC Hall six-step commutation\n// Gate order: A_high, B_high, C_high, A_low, B_low, C_low\nint hall = (int)(4.0*in[2] + 2.0*in[1] + in[0]);\n\nout[0]=0.0; out[1]=0.0; out[2]=0.0;\nout[3]=0.0; out[4]=0.0; out[5]=0.0;\n\nswitch(hall) {\n    case 5: out[0]=1.0; out[4]=1.0; break; // A+ B-\n    case 1: out[0]=1.0; out[5]=1.0; break; // A+ C-\n    case 3: out[1]=1.0; out[5]=1.0; break; // B+ C-\n    case 2: out[1]=1.0; out[3]=1.0; break; // B+ A-\n    case 6: out[2]=1.0; out[3]=1.0; break; // C+ A-\n    case 4: out[2]=1.0; out[4]=1.0; break; // C+ B-\n    default: break;\n}\n"
    }
